{
  "name": "videopilot",
  "version": "0.1.0",
  "description": "Local video editor for macOS",
  "author": "Garik Sukhanov",
  "license": "MIT",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "prepare:icon": "node scripts/prepare-icon.mjs",
    "dist": "npm run prepare:ffmpeg && electron-vite build && electron-builder --mac --universal",
    "dist:universal": "npm run prepare:ffmpeg && electron-vite build && electron-builder --mac --universal",
    "dist:arm64": "npm run prepare:ffmpeg && electron-vite build && electron-builder --mac --arm64",
    "dist:x64": "npm run prepare:ffmpeg && electron-vite build && electron-builder --mac --x64"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.videopilot.app",
    "productName": "VideoPilot",
    "copyright": "Copyright © 2026 Igor Sukhanov",
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffprobe-static/bin/**"
    ],
    "extraResources": [
      {
        "from": "build/vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffprobe"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": null,
      "x64ArchFiles": "Contents/Resources/ffmpeg/*",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  }
}
